# Copie vers .env et .env.local — variables préfixées VITE_ uniquement.
# Attention : .env.local a priorité sur .env. Ne laisse pas VITE_SUPABASE_URL / ANON_KEY vides dans .env.local
# sinon tu écrases les valeurs de .env et Supabase reste désactivé.
# Backend Django : https://github.com/Souley97/Al_Toppe_Backend.git

# --- API Django (si auth Supabase désactivée) ---
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_LEGACY_DJANGO_API_ENABLED=true

# --- Supabase (Project Settings → API) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# true = connexion / session via Supabase Auth (email + mot de passe).
# false = auth historique Django (téléphone + mot de passe) vers VITE_API_BASE_URL
VITE_SUPABASE_AUTH_ENABLED=false

# Rôle par défaut si absent de user_metadata.role / app_metadata.role (entrepreneur|coach|admin|bailleur)
VITE_SUPABASE_DEFAULT_ROLE=entrepreneur

# Optionnel : URL du site après magic link / OAuth (ex. https://app.altoppe.sn)
VITE_SUPABASE_AUTH_REDIRECT_URL=

# Voie parallèle (modules hors Django)
VITE_PARALLEL_FEATURES_ENABLED=false

# --- Connexion rapide par rôle (démo) ---
# En dev : zones de test affichées automatiquement. Sur Vercel / preview : VITE_ENABLE_TEST_LOGIN=true
# VITE_ENABLE_TEST_LOGIN=false
#
# Django (auth Supabase off) : mot de passe seed_test_users
# VITE_DEV_TEST_PASSWORD=
#
# Supabase Auth : même mot de passe pour les 4 comptes de test (créés dans le dashboard Supabase)
# VITE_SUPABASE_TEST_PASSWORD=
# Optionnel : emails si tu ne veux pas des défauts @example.com
# VITE_SUPABASE_TEST_EMAIL_ENTREPRENEUR=
# VITE_SUPABASE_TEST_EMAIL_COACH=
# VITE_SUPABASE_TEST_EMAIL_BAILLEUR=
# VITE_SUPABASE_TEST_EMAIL_ADMIN=

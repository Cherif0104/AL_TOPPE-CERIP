# Configuration Django AL-TOPPE
# Copiez ce fichier vers .env et modifiez les valeurs selon votre environnement

# ============================================================================
# CONFIGURATION DE BASE
# ============================================================================
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.54.96

# ============================================================================
# BASE DE DONNÉES
# ============================================================================
# Pour le développement local (SQLite)
DATABASE_URL=sqlite:///db.sqlite3

# Pour la production (PostgreSQL)
# DATABASE_URL=postgresql://username:password@localhost:5432/altoppe_db

# Configuration PostgreSQL détaillée
DB_ENGINE=django.db.backends.postgresql
DB_NAME=altoppe_db
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# ============================================================================
# REDIS (Cache et Sessions)
# ============================================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# SÉCURITÉ
# ============================================================================
# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://192.168.54.96:8081

# SSL/TLS
SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# ============================================================================
# SERVICES EXTERNES
# ============================================================================
# Twilio (SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+221XXXXXXXX

# OpenAI (IA - Déprécié, utilisez Gemini)
OPENAI_API_KEY=your-openai-api-key

# Google Gemini (IA - Nouveau système)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=4096

# Services de paiement
ORANGE_MONEY_API_KEY=your-orange-money-key
WAVE_API_KEY=your-wave-api-key

# ============================================================================
# EMAIL
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=AL-TOPPE <noreply@altoppe.sn>

# ============================================================================
# STOCKAGE DE FICHIERS
# ============================================================================
# Local
MEDIA_ROOT=media/
STATIC_ROOT=staticfiles/

# Cloud (pour production)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=altoppe-media
# AWS_S3_REGION_NAME=us-east-1

# ============================================================================
# MONITORING ET LOGS
# ============================================================================
# Sentry (Error tracking)
SENTRY_DSN=your-sentry-dsn

# Log Level
LOG_LEVEL=INFO

# ============================================================================
# CONFIGURATION SPÉCIFIQUE AL-TOPPE
# ============================================================================
# Limites métier
MIN_TRANSACTION_AMOUNT=100
MAX_TRANSACTION_AMOUNT=10000000

# Configuration SMS
SMS_VERIFICATION_ENABLED=True
SMS_OTP_EXPIRY_MINUTES=5

# Configuration IA
AI_VOICE_ENABLED=True
AI_CONFIDENCE_THRESHOLD=0.7
USE_GEMINI=true

# Configuration multilingue
DEFAULT_LANGUAGE=fr
SUPPORTED_LANGUAGES=fr,wo

# ============================================================================
# ENVIRONNEMENT
# ============================================================================
ENVIRONMENT=development
# ENVIRONMENT=production
# ENVIRONMENT=staging


# AL-TOPPE Production Environment Variables
# Copy this file to .env on your VPS server

# Environment settings
DJANGO_ENV=production
DEBUG=False

# Security
SECRET_KEY=your-super-secret-production-key-here
ALLOWED_HOSTS=72.60.189.237,your-domain.sn,www.your-domain.sn

# Database (PostgreSQL for production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=altoppe_prod
DB_USER=altoppe_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# CORS settings
CORS_ALLOWED_ORIGINS=https://your-domain.sn,https://www.your-domain.sn,https://your-mobile-app.com

# File storage
STATIC_ROOT=/var/www/al-toppe/staticfiles
MEDIA_ROOT=/var/www/al-toppe/media

# Email configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=AL-TOPPE <noreply@altoppe.sn>

# Redis for cache and Celery
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Business logic settings
MIN_TRANSACTION_AMOUNT=100
MAX_TRANSACTION_AMOUNT=10000000
SMS_VERIFICATION_ENABLED=True
SMS_OTP_EXPIRY_MINUTES=5

# AI and Voice settings
AI_VOICE_ENABLED=True
AI_CONFIDENCE_THRESHOLD=0.7

# External API keys (optional)
OPENAI_API_KEY=your-openai-key
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=your-twilio-number

# Monitoring (optional)
SENTRY_DSN=your-sentry-dsn

# Logging
LOG_LEVEL=INFO
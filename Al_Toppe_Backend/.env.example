# =============================================================================
# AL-TOPPE Backend — variables d’environnement (exemple)
# Dépôt : https://github.com/Souley97/Al_Toppe_Backend.git
#
# Copie ce fichier en ".env" à la racine du backend et adapte les valeurs.
# Ne commite jamais le vrai ".env".
# =============================================================================

SECRET_KEY=remplacer-par-une-cle-longue-et-aleatoire
DJANGO_ENV=development
DEBUG=True
ENVIRONMENT=development

# IA (optionnel)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
USE_GEMINI_ONLY_FOR_AUDIO=true
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=4096
USE_GEMINI=True

ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — préférer DB_* OU une DATABASE_URL correctement encodée
DB_NAME=altoppe
DB_USER=altoppe_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Si mot de passe avec @ ou caractères spéciaux : utiliser %40 pour @ dans DATABASE_URL
# DATABASE_URL=postgresql://USER:MOT_DE_PASSE_ENCODE@localhost:5432/altoppe

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=contact@altoppe.sn
